# =============================================================================
# TALYNTRA BACKEND SERVICE ENVIRONMENT VARIABLES
# Security: This file holds sensitive server keys. NEVER commit real keys to git!
# =============================================================================

# Google Gemini API Key (Get yours free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Postgres & Auth Configuration (Optional for local slice, required for cloud sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Frontend CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
